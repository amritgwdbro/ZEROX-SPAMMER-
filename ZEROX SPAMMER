-- Spammer Logic
local spamming = false

StartStopBtn.MouseButton1Click:Connect(function()
	spamming = not spamming
	if spamming then
		StartStopBtn.Text = "■ STOP SPAM"
		StartStopBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
		StatusLabel.Text = "Status: RUNNING..."
		StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)

		task.spawn(function()
			local lineIndex = 1
			while spamming do
				local targets = {}
				if TargetBox1.Text ~= "" then table.insert(targets, TargetBox1.Text) end
				if TargetBox2.Text ~= "" then table.insert(targets, TargetBox2.Text) end
				if TargetBox3.Text ~= "" then table.insert(targets, TargetBox3.Text) end
				if TargetBox4.Text ~= "" then table.insert(targets, TargetBox4.Text) end

				if #targets == 0 then table.insert(targets, "TMX") end

				for _, targetVal in ipairs(targets) do
					if not spamming then break end

					local rawLine = zeroxLines[lineIndex]
					local finalMsg = rawLine:gsub("%[TARGET NAME%]", targetVal)

					lineIndex = lineIndex + 1
					if lineIndex > #zeroxLines then
						lineIndex = 1
					end

					-- Add Emoji Cycle if enabled
					if emojiCycleEnabled then
						local currentEmoji = emojis[emojiIndex]
						finalMsg = finalMsg .. " " .. currentEmoji
						emojiIndex = emojiIndex + 1
						if emojiIndex > #emojis then
							emojiIndex = 1
						end
					end

					sendMessage(finalMsg)

					local delayTime = tonumber(DelayBox.Text) or 1
					task.wait(delayTime < 0.1 and 0.1 or delayTime)
				end
			end
		end)
	else
		StartStopBtn.Text = "▶ START SPAM"
		StartStopBtn.TextColor3 = Color3.fromRGB(0, 255, 120)
		StatusLabel.Text = "Status: STOPPED / IDLE"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
	end
end)
